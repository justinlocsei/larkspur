{
  "name": "larkspur",
  "version": "0.1.0",
  "description": "A TypeScript-first CLI library optimized for internal tools",
  "keywords": [
    "cli",
    "commands",
    "completions",
    "shell"
  ],
  "homepage": "https://github.com/justinlocsei/larkspur#readme",
  "bugs": {
    "url": "https://github.com/justinlocsei/larkspur/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinlocsei/larkspur.git"
  },
  "author": "Justin Locsei",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.mjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node tasks/index.ts build",
    "check": "node tasks/index.ts check",
    "format": "node tasks/index.ts format code",
    "prepublishOnly": "npm run build",
    "test": "node tasks/index.ts test all"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@fast-check/vitest": "^0.4.1",
    "@types/node": "^26.4.1",
    "dprint": "^0.57.1",
    "fast-check": "^4.9.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "dprint@0.56.0": true,
    "fsevents@2.3.3": true
  }
}
